# Browser-safe values. The publishable key replaces the legacy anon key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Leave empty to use the same-origin /api handlers. Set this only if the API
# is hosted somewhere else, e.g. http://localhost:4000
VITE_API_BASE_URL=

# Server only - never use VITE_ prefix or expose these values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Optional: derived from SUPABASE_URL when omitted. Pin it explicitly for self-hosted stacks.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Needed for media storage and provisioning rollback.
# Use the Session pooler connection string from the same project.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Required for real email delivery. Without these values no email is sent:
# in local development the code is only printed in the Vite terminal, and in
# production /api/send-code returns an error.
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<brevo-login>, SMTP_PASS=<brevo-smtp-key>
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=<resend-api-key>
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=<gmail>, SMTP_PASS=<app-password>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<brevo-login>
SMTP_PASS=<brevo-smtp-key>
# Must be a sender/domain verified in your Brevo account.
SMTP_FROM="Mercury FM" <no-reply@yourdomain.com>
SMTP_SECURE=false

# Optional security controls. Leave blank to disable Turnstile locally.
APP_ORIGIN=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
