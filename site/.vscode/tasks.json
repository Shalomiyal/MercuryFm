			"label": "Inspect project documents",
			"type": "shell",
			"command": "python",
			"args": [
				"-c",
				"import zipfile,re,glob,os,sys\nfor ppt in glob.glob(r'E:\\KenWeb\\MercuryFm\\docs\\*.pptx'):\n z=zipfile.ZipFile(ppt)\n print('PPTX_SLIDES')\n for n in sorted([n for n in z.namelist() if re.match(r'ppt/slides/slide\\d+\\.xml$',n)],key=lambda x:int(re.search(r'(\\d+)',x.split('/')[-1]).group(1))):\n  s=z.read(n).decode('utf-8','replace')\n  txt=[re.sub('<[^>]+>','',x) for x in re.findall(r'<a:t[^>]*>(.*?)</a:t>',s,re.S)]\n  print(n+': '+' | '.join(txt))\nprint('PDF_PAGE_MARKERS')\npdf=r'E:\\KenWeb\\MercuryFm\\docs\\Estimate.pdf'\ndata=open(pdf,'rb').read()\nprint('bytes='+str(len(data))+' pdf_pages='+str(data.count(b'/Type /Page'))\n"
			],
